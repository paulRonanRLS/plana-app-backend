# ======================
# Database
# ======================
DATABASE_URL=postgresql://recipe_user:recipe_dev_password@localhost:5432/recipe_app

# ======================
# Redis
# ======================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ======================
# App
# ======================
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret-key
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# ======================
# Firebase Auth
# ======================
# Set to true to enable real Firebase authentication
# Set to false for stub mode (testing/development without Firebase)
FIREBASE_ENABLED=false

# Download service account JSON from Firebase Console > Project Settings > Service Accounts
# Required when FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Your Firebase project ID
FIREBASE_PROJECT_ID=rls-recipe

# Firebase Web API Key (for dev scripts)
# Get from Firebase Console > Project Settings > General > Web API Key
FIREBASE_WEB_API_KEY=AIzaSyBJ_OshTdifDchLireeDVhwCUXk7uCuDEA

# Test user credentials (for dev scripts)
FIREBASE_TEST_EMAIL=test@rls-recipe.dev
FIREBASE_TEST_PASSWORD=TestPassword123!

# ======================
# Anthropic (Claude API)
# ======================
# ANTHROPIC_API_KEY=sk-ant-...

# ======================
# Google Cloud Vision (OCR)
# ======================
# GOOGLE_CLOUD_CREDENTIALS_PATH=./google-cloud-service-account.json

# ======================
# Google Cloud Storage (File Storage)
# ======================
# Set to true to use Google Cloud Storage for file uploads
# Set to false for local filesystem storage (development)
USE_GCS=false

# GCS bucket name (required when USE_GCS=true)
# GCS_BUCKET_NAME=recipe-app-uploads

# Note: GCS uses the same GOOGLE_APPLICATION_CREDENTIALS as Vision API
# (set via GOOGLE_CLOUD_CREDENTIALS_PATH above)
