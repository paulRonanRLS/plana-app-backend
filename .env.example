# ======================
# Database
# ======================
DATABASE_URL=postgresql://recipe_user:recipe_dev_password@localhost:5432/recipe_app

# ======================
# Redis
# ======================
REDIS_URL=redis://localhost:6379/0

# ======================
# App
# ======================
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret-key
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# ======================
# Firebase Auth
# ======================
# Download from Firebase Console > Project Settings > Service Accounts
# FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ======================
# Anthropic (Claude API)
# ======================
# ANTHROPIC_API_KEY=sk-ant-...

# ======================
# Google Cloud Vision (OCR)
# ======================
# GOOGLE_CLOUD_CREDENTIALS_PATH=./google-cloud-service-account.json

# ======================
# AWS S3 (File Storage)
# ======================
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_BUCKET=recipe-app-uploads
# AWS_S3_REGION=eu-west-2

# ======================
# File Storage (local dev)
# ======================
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
